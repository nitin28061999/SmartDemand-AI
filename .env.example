# SmartDemand AI environment configuration example.
# Copy to .env only if you choose to use a local environment-file loader.
# Never commit real credentials or production secrets.

ENVIRONMENT=development
ENABLE_DOCS=true

# Leave empty for local development without API authentication.
API_KEY=
METRICS_API_KEY=

# Local artifact paths. Defaults are used when these are empty or unset.
# MODEL_PATH=
# HISTORY_FILE=

# Leave S3_BUCKET empty to use local artifacts.
S3_BUCKET=
AWS_REGION=ap-southeast-2
MODEL_KEY=models/xgboost_final_model.joblib
HISTORY_KEY=serving/history.csv
